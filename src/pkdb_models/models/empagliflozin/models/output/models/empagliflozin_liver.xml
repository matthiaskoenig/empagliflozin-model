    <listOfReactions>
      <reaction sboTerm="SBO:0000176" id="EMP2EG" name="empagliflozin glucuronidation (EMP2EG)" reversible="false" compartment="Vli">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>Uptake of the empagliflozin of the plasma of the liver and its
glucuronidation; the export of EG into the plasma is fast.</p>
          </body>
        </notes>
        <listOfReactants>
          <speciesReference species="emp_ext" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="eg_ext" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> f_oatp </ci>
              <ci> f_ugt </ci>
              <ci> EMP2EG_k </ci>
              <ci> Vli </ci>
              <ci> emp_ext </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
